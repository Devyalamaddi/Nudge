# ==============================================================================
# minimi Chat Agent Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider (Choose one primary provider)
# ------------------------------------------------------------------------------
# OpenAI (Default & Recommended for fast function calling and streaming)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini # Options: gpt-4o, gpt-4o-mini

# Anthropic Claude (Alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. Web Search Tool Provider (Strictly ONE tool: web_search)
# ------------------------------------------------------------------------------
# Tavily Search (Recommended: clean markdown extraction, dates, and LLM-ready snippets)
# Sign up at https://tavily.com (free 1,000 searches/month)
TAVILY_API_KEY=your_tavily_api_key_here

# Brave Search (Alternative)
# BRAVE_API_KEY=your_brave_api_key_here

# Serper / Google Search (Alternative)
# SERPER_API_KEY=your_serper_api_key_here

# Zero-Key Fallback:
# If no search API key is provided, the agent automatically falls back to an
# internal DuckDuckGo / web scraping parser so you can test without signing up.

# ------------------------------------------------------------------------------
# 3. Agent Configuration & Simulation Mode
# ------------------------------------------------------------------------------
# Set to 'true' to run in mock simulation mode (no API keys required for offline demo)
MOCK_MODE=true

# Port (Next.js defaults to 3000)
PORT=3000
